# Basic GCP Compute Example Configuration
# Copy this file to terraform.tfvars and customize the values

# Application Configuration
name             = "basic-compute"
environment      = "dev"
environment_type = "Development"

# GCP Configuration
gcp_project_id = "your-project-id"
gcp_region     = "us-west1"
gcp_zone       = "us-west1-a"

# Compute Configuration
instance_type = "small"
image_family  = "ubuntu-2004-lts"
image_project = "ubuntu-os-cloud"

# Network Configuration
network_name = ""  # Leave empty to use default network
subnet_name  = ""  # Leave empty to use default subnet

# Security Configuration
allowed_cidr_blocks = ["0.0.0.0/0"]  # WARNING: Open to internet - restrict in production
ssh_public_keys     = []             # Add your SSH public keys here

# Feature Configuration
create_kms_key      = true
monitoring_enabled  = false
alarms_enabled      = false

# Additional Labels
additional_labels = {
  project = "basic-compute-example"
  owner   = "devops"
}